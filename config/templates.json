{
  "_brand": {
    "_comment": "HVT brand identity — change once here, propagates everywhere",
    "primary_color": "#FFFFFF",
    "accent_color": "#00FF88",
    "warning_color": "#FF3344",
    "neutral_color": "#9CA3AF",
    "bg_color": "black",
    "font_face_hint": "Helvetica, Inter, or San Francisco — set system font in render.py if needed"
  },

  "hvt": {
    "description": "Default template. Institutional, clean, signal-focused. Matches highvelocitytrading.com aesthetic.",
    "music": {
      "file": "assets/music/hvt_default.mp3",
      "volume_db": -22,
      "duck_volume_db": -32,
      "duck_at_marker_times_for_seconds": 0.6
    },
    "sounds": {
      "entry": { "file": "assets/sounds/signal_tick.mp3", "volume_db": -10 },
      "target": { "file": "assets/sounds/signal_confirm.mp3", "volume_db": -8 },
      "stop": { "file": "assets/sounds/signal_stop.mp3", "volume_db": -10 },
      "intro_whoosh_at_t0": { "file": "assets/sounds/intro_riser.mp3", "volume_db": -14 }
    },
    "overlays": {
      "hook": {
        "font_size": 64,
        "font_color": "white",
        "bg_color": "black@0.85",
        "y_position": 180,
        "duration_sec": 2.5,
        "fade_in_sec": 0.3
      },
      "entry_label": {
        "text": "ENTRY",
        "font_size": 42,
        "font_color": "#00FF88",
        "bg_color": "black@0.85",
        "duration_sec": 1.2
      },
      "target_label": {
        "text": "TARGET",
        "font_size": 50,
        "font_color": "#00FF88",
        "bg_color": "black@0.85",
        "duration_sec": 1.5
      },
      "stop_label": {
        "text": "STOP",
        "font_size": 42,
        "font_color": "#FF3344",
        "bg_color": "black@0.85",
        "duration_sec": 1.2
      },
      "watermark_image": {
        "file": "assets/branding/hvt_watermark.png",
        "x": "(W-w)/2",
        "y": "H-130",
        "opacity": 0.85
      },
      "url_text": {
        "text": "highvelocitytrading.com",
        "font_size": 24,
        "font_color": "#00FF88",
        "x": "(w-text_w)/2",
        "y": "h-32"
      },
      "cta_card": {
        "file": "assets/branding/cta_card.png",
        "duration_sec": 2.5
      }
    }
  },

  "hvt-clean": {
    "description": "Minimal. For educational/lesson clips. Quieter, slower, more reflective.",
    "music": {
      "file": "assets/music/hvt_clean.mp3",
      "volume_db": -24,
      "duck_volume_db": -34,
      "duck_at_marker_times_for_seconds": 0.5
    },
    "sounds": {
      "entry": { "file": "assets/sounds/signal_tick_soft.mp3", "volume_db": -12 },
      "target": { "file": "assets/sounds/signal_confirm_soft.mp3", "volume_db": -10 },
      "stop": { "file": "assets/sounds/signal_stop_soft.mp3", "volume_db": -12 }
    },
    "overlays": {
      "hook": {
        "font_size": 56,
        "font_color": "white",
        "bg_color": "black@0.75",
        "y_position": 200,
        "duration_sec": 3.0,
        "fade_in_sec": 0.5
      },
      "entry_label": {
        "text": "ENTRY",
        "font_size": 36,
        "font_color": "#00FF88",
        "bg_color": "black@0.75",
        "duration_sec": 1.4
      },
      "target_label": {
        "text": "TARGET",
        "font_size": 44,
        "font_color": "#00FF88",
        "bg_color": "black@0.75",
        "duration_sec": 1.8
      },
      "stop_label": {
        "text": "STOP",
        "font_size": 36,
        "font_color": "#FF3344",
        "bg_color": "black@0.75",
        "duration_sec": 1.4
      },
      "watermark_image": {
        "file": "assets/branding/hvt_watermark.png",
        "x": "(W-w)/2",
        "y": "H-90",
        "opacity": 0.75
      },
      "url_text": {
        "text": "highvelocitytrading.com",
        "font_size": 24,
        "font_color": "#00FF88",
        "x": "(w-text_w)/2",
        "y": "h-50"
      },
      "cta_card": {
        "file": "assets/branding/cta_card.png",
        "duration_sec": 3.0
      }
    }
  },

  "hvt-results": {
    "description": "Slightly more energy for big-result reveals. Still on-brand. NOT trap/hype.",
    "music": {
      "file": "assets/music/hvt_results.mp3",
      "volume_db": -20,
      "duck_volume_db": -30,
      "duck_at_marker_times_for_seconds": 0.7
    },
    "sounds": {
      "entry": { "file": "assets/sounds/signal_tick.mp3", "volume_db": -8 },
      "target": { "file": "assets/sounds/signal_confirm_strong.mp3", "volume_db": -4 },
      "stop": { "file": "assets/sounds/signal_stop.mp3", "volume_db": -8 },
      "intro_whoosh_at_t0": { "file": "assets/sounds/intro_riser.mp3", "volume_db": -12 }
    },
    "overlays": {
      "hook": {
        "font_size": 72,
        "font_color": "white",
        "bg_color": "black@0.9",
        "y_position": 180,
        "duration_sec": 2.2,
        "fade_in_sec": 0.2
      },
      "entry_label": {
        "text": "ENTRY",
        "font_size": 46,
        "font_color": "#00FF88",
        "bg_color": "black@0.85",
        "duration_sec": 1.2
      },
      "target_label": {
        "text": "TARGET",
        "font_size": 56,
        "font_color": "#00FF88",
        "bg_color": "black@0.85",
        "duration_sec": 1.8
      },
      "stop_label": {
        "text": "STOP",
        "font_size": 46,
        "font_color": "#FF3344",
        "bg_color": "black@0.85",
        "duration_sec": 1.2
      },
      "watermark_image": {
        "file": "assets/branding/hvt_watermark.png",
        "x": "(W-w)/2",
        "y": "H-90",
        "opacity": 0.9
      },
      "url_text": {
        "text": "highvelocitytrading.com",
        "font_size": 28,
        "font_color": "#00FF88",
        "x": "(w-text_w)/2",
        "y": "h-50"
      },
      "cta_card": {
        "file": "assets/branding/cta_card.png",
        "duration_sec": 2.5
      }
    }
  }
}
